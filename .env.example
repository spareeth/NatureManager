# Copy to .env.local and fill in. Never commit .env.local.

# Web app (Vite exposes only VITE_* to the browser)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-start
VITE_AI_SERVICE_URL=http://127.0.0.1:8088
# Optional: Google satellite layer via the Map Tiles API. Restrict the key to your domains in
# Google Cloud (it is visible in the browser). Leave empty to hide the layer.
VITE_GOOGLE_MAPS_API_KEY=

# Server-side only (scripts, AI service). Do not prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AI service
AI_SERVICE_PORT=8088
AI_ALLOWED_ORIGINS=http://localhost:5173
